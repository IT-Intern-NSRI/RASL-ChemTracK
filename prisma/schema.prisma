// prisma/schema.prisma
//
// Fully implemented (declarative) — this is the database schema itself,
// not business logic, so unlike the .ts files in this project it doesn't
// contain "Not implemented" stubs. Run `npm run prisma:migrate` after
// setting DATABASE_URL to create these tables in your Postgres instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per chemical. currentBalance is the total-inventory figure
// ("Current Balance" in the app's UI): increased by STOCK_IN, decreased by
// USAGE, unaffected by REPLENISH. currentOutBalance is the separate
// "Current Out Balance" figure — the amount currently decanted into the
// smaller day-to-day working container: increased by REPLENISH, decreased
// by USAGE, unaffected by STOCK_IN. Both are cached "latest" figures kept
// in sync by src/lib/balance.ts on every write/edit/delete; each equals
// the corresponding chained field (currentBalanceAfter / balanceOut) of
// that chemical's most recent Transaction row (by sequenceNo).
model Chemical {
  id                String   @id @default(cuid())
  name              String // short display name, used on the dashboard
  cpecsDescriptor   String // full "name, form, purity, packaging" string, used on exports
  category          String?
  unit              String   @default("L")
  currentBalance    Decimal  @default(0) @db.Decimal(14, 4)
  currentOutBalance Decimal  @default(0) @db.Decimal(14, 4)
  lowStockThreshold Decimal? @db.Decimal(14, 4)
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions Transaction[]

  @@index([name])
}

enum TransactionType {
  STOCK_IN
  USAGE
  REPLENISH
}

// One row per stock-in, usage, OR replenish instance (never more than one
// of these per row — this is what makes a same-day stock-in + usage two
// independent rows, per the project's edge-case rule; replenish instances
// follow the same rule). Both chain fields are stored at write-time; see
// src/lib/balance.ts for why the ledger chain follows sequenceNo rather
// than the date fields.
//
// balanceOut = the running "Current Out Balance" chain value after this
// row (STOCK_IN carries it forward unchanged; USAGE decreases it;
// REPLENISH increases it). This is what prints in the exported PDF's
// "Balance (Out)" column.
//
// currentBalanceAfter = the running "Current Balance" (total inventory)
// chain value after this row (STOCK_IN increases it; USAGE decreases it;
// REPLENISH leaves it unchanged). Not shown in the exported PDF table,
// but needed so edits/deletes can correctly recompute history, and shown
// in the app's own transaction history view.
model Transaction {
  id         String          @id @default(cuid())
  chemicalId String
  chemical   Chemical        @relation(fields: [chemicalId], references: [id])
  type       TransactionType
  sequenceNo Int // monotonic per chemical, assigned at write-time (insertion order)

  // --- stock-in fields (populated only when type = STOCK_IN) ---
  dateReceived     DateTime? @db.Date
  supplierInfo     String?
  truckerCarrier   String?
  lotBatchNo       String?
  quantityReceived Decimal?  @db.Decimal(14, 4)

  // --- usage fields (populated only when type = USAGE) ---
  dateUsed       DateTime? @db.Date
  detailsOfUsage String?
  workOrderNo    String?
  lotBatchNoUsed String?
  quantityUsed   Decimal?  @db.Decimal(14, 4)

  // --- replenish fields (populated only when type = REPLENISH) ---
  // Moves quantity from bulk stock into the smaller day-to-day working
  // container. Distinct from STOCK_IN, which is newly purchased/received
  // stock. Replenish rows are excluded from the exported PDF.
  dateReplenished     DateTime? @db.Date
  quantityReplenished Decimal?  @db.Decimal(14, 4)
  replenishNotes      String?

  // --- shared ---
  balanceOut          Decimal @db.Decimal(14, 4) // running "Current Out Balance" after this row
  currentBalanceAfter Decimal @db.Decimal(14, 4) // running "Current Balance" (total inventory) after this row
  balanceOverridden   Boolean @default(false) // true if the user manually overwrote the auto-computed balanceOut
  isOverdrawn         Boolean @default(false) // true if a USAGE row drove the Out Balance negative (flagged, never blocked)
  isAnchor            Boolean @default(false) // true if retained across a 5-year purge as the pre-cutoff balance anchor

  edited      Boolean @default(false)
  editHistory Json? // array of { field, oldValue, newValue, editedAt } entries

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chemicalId, sequenceNo])
  @@index([chemicalId, dateUsed])
  @@index([chemicalId, dateReceived])
  @@index([chemicalId, dateReplenished])
}

// Single-row table (id is always 1) holding the fixed/global settings that
// print on every exported document, plus the one admin password hash,
// since this is a single-user app.
model AppSettings {
  id                   Int      @id @default(1)
  organizationName     String?
  registerLabel        String? // e.g. "PDEA P Register 2-13"
  signatoryName        String?
  signatoryCredentials String? // e.g. "Ph.D., R.Ch."
  signatoryTitle       String? // e.g. "Pollution Control Officer, NSRI"
  passwordHash         String
  updatedAt            DateTime @updatedAt
}

// Written once per confirmed purge run (src/lib/purge.ts). The deleted rows
// themselves are gone, but the fact that a purge happened, when, and what
// it covered is retained for audit purposes.
model PurgeLog {
  id          String   @id @default(cuid())
  cutoffDate  DateTime @db.Date
  performedAt DateTime @default(now())
  summary     Json // { chemicalId: rowsDeletedCount, ... } plus totals
}

// A prepared-but-not-yet-confirmed purge plan (see the two-step
// prepare/confirm flow in src/lib/purge.ts). Expires after ~15 minutes;
// confirming deletes this row along with the planned transactions.
model PurgePreparation {
  id                     String   @id @default(cuid())
  token                  String   @unique
  cutoffDate             DateTime @db.Date
  transactionIdsToDelete Json
  anchorTransactionIds   Json
  createdAt              DateTime @default(now())
  expiresAt              DateTime
}
